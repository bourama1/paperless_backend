{
    "name": "paperless_backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon --watch src/**/*.ts --exec ts-node src/index.ts",
        "build": "tsc --project tsconfig.build.json",
        "lint": "eslint --ext .ts --config eslint.config.mjs src",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "test": "jest",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "axios": "^1.18.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "knex": "^3.2.10",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "pdf-lib": "^1.17.1",
        "pg": "^8.22.0",
        "socket.io": "^4.8.3",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "eslint": "^10.2.0",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "jiti": "^2.6.1",
        "lint-staged": "^17.0.8",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.4",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.2"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix --config eslint.config.mjs",
            "prettier --write",
            "jest --bail --findRelatedTests"
        ]
    }
}
