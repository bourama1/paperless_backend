{
    "name": "paperless_backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon --watch src/**/*.ts --exec ts-node src/index.ts",
        "build": "tsc --project tsconfig.build.json",
        "lint": "eslint --ext .ts --config eslint.config.mjs src",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "test": "jest --forceExit",
        "prepare": "husky",
        "test:compare": "powershell -ExecutionPolicy Bypass -File scripts/Compare-VbaAndBackend.ps1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "axios": "^1.19.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "knex": "^3.3.0",
        "morgan": "^1.11.0",
        "pg": "^8.22.0",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^25.9.5",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@yao-pkg/pkg": "^6.21.0",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.2.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix --config eslint.config.mjs",
            "prettier --write",
            "jest --bail --findRelatedTests"
        ]
    }
}
