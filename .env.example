PORT=5300
NODE_ENV=development
STORAGE_PATH=./storage

# ── Access control & transport security ───────────────────────────────────────
# Shared secret required on every request (header: X-API-Key) and on every
# Socket.IO connection (handshake auth.apiKey). Must match the value baked
# into the mobile app's EXPO_PUBLIC_API_KEY. Generate with e.g.:
#   openssl rand -hex 32
API_KEY=

# TLS certificate/key paths. Leave both empty to run plain HTTP (local dev
# only). Set both to serve HTTPS/WSS — required whenever this server is
# reachable from the shop-floor WiFi.
SSL_CERT_PATH=
SSL_KEY_PATH=

# ── PostgreSQL connection ─────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=paperless
PG_USER=postgres
PG_PASSWORD=

# Workstation polling
WORKSTATIONS_API_URL=http://localhost:40000/api/p2l/services/workstations_process
WORKSTATIONS_POLL_INTERVAL=15000

# Document manager API
DOC_MANAGER_URL=http://localhost:5200

# Network share for edited PDFs (leave empty to skip)
EDITED_PDF_PATH=

# ── Label printing ────────────────────────────────────────────────────────────
# Which action triggers printing: STARTED or FINISHED
LABEL_PRINT_TRIGGER=STARTED

# UNC path to the Stitky folder (where {salesOrder} {position}.csv files live)
LABEL_CSV_BASE_PATH=

# Path to country code mapping JSON file
LABEL_COUNTRY_CODES_PATH=

# Path to label type config JSON file
LABEL_TYPE_CONFIG_PATH=

# ── Godex EZ2250i printer connection (pick ONE method) ────────────────────────
# METHOD 1 (recommended): UNC print share
LABEL_PRINTER_UNC_PATH=

# METHOD 2 (fallback): direct TCP to the printer's IP, port 9100
LABEL_PRINTER_HOST=
LABEL_PRINTER_PORT=9100

# Optional: override copy count from config for all labels
# LABEL_PRINTER_COPIES=1

# ── QR sticker printing ───────────────────────────────────────────────────────
# Path to TMP*.TXT order files
LABEL_TMP_FILES_PATH=
# Path to the folder containing QR PNG images
LABEL_QR_IMAGES_PATH=

# ── Document printing (PBOM, declarations, confirmations) ─────────────────────
# Printer's IP address (leave empty for dry-run).
DOCUMENTS_PRINTER_HOST=
DOCUMENTS_PRINTER_PORT=9100
# Ghostscript output device: pxlmono (default), pxlcolor, ljet4, ps2write
DOCUMENTS_PRINTER_DEVICE=pxlmono
# Comma-separated list of document type IDs to fetch from doc_manager
DOCUMENTS_TYPES=4,5

# ── Retention archival ────────────────────────────────────────────────────────
# Network share path for archived PDF/A copies (leave empty to disable)
ARCHIVE_SHARE_PATH=
# Days after FINISHED before archival eligibility
ARCHIVE_RETENTION_DAYS=7
# Comma-separated document type IDs to archive
ARCHIVE_DOCUMENT_TYPES=14,4,5,21
# How often the archival sweep runs (ms) - default 6 hours
ARCHIVE_POLL_INTERVAL_MS=21600000
# Max retry attempts per order before giving up
ARCHIVE_MAX_ATTEMPTS=5

# ── Ghostscript (for PDF/A conversion) ────────────────────────────────────────
# Path to Ghostscript binary (must be on PATH if not specified)
GHOSTSCRIPT_PATH=.\gs\bin\gswin64c.exe