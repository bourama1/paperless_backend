PORT=5300
NODE_ENV=development
STORAGE_PATH=./storage

# ── Logging ──────────────────────────────────────────────────────────────
# Minimum level written to console AND app.log: debug | info | warn | error
# (default: info).
LOG_LEVEL=info
# Where the log file lives. Relative paths resolve against the project root
# (i.e. the process working directory). Default: app.log. `*.log` is
# gitignored.
LOG_FILE_PATH=app.log

# ── Access control & transport security ───────────────────────────────────────
# Shared secret required on every request (header: X-API-Key) and on every
# Socket.IO connection (handshake auth.apiKey). Must match the value baked
# into the mobile app's EXPO_PUBLIC_API_KEY. Generate with e.g.:
#   openssl rand -hex 32
API_KEY=

# TLS certificate/key paths. Leave both empty to run plain HTTP (local dev
# only). Set both to serve HTTPS/WSS — required whenever this server is
# reachable from the shop-floor WiFi.
# TLS: export cert from IIS as .pfx (right-click cert -> Export) and set SSL_PFX_PATH.
# Or split into PEM files: openssl pkcs12 -in cert.pfx -nokeys -out server.crt -nodes
#                          openssl pkcs12 -in cert.pfx -nocerts -out server.key -nodes
SSL_PFX_PATH=
SSL_PFX_PASSPHRASE=
SSL_CERT_PATH=
SSL_KEY_PATH=

# ── PostgreSQL connection ─────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=paperless
PG_USER=postgres
PG_PASSWORD=

# ── Masterplan database (read-only, same server as above) ─────────────────────
# Name of the Masterplan PostgreSQL database on the same server. Used to check
# vyroba.tisk_zamcen when serving the prep queue — orders where tisk_zamcen=1
# are locked and shown as unprocessable. Same host/port/user/password as above;
# leave empty to disable lock checks (all items will appear unlocked).
MASTERPLAN_DB_NAME=

# Norms database (read-only, same server)
# Used to look up production order numbers (vyr_obj) for prep labels.
# Query: txtfiles (zakazka + prodejni_objednavka + pozice) -> konfiguratory (vyr_obj)
NORMS_DB_NAME=

# Workstation polling
WORKSTATIONS_API_URL=http://localhost:40000/api/p2l/services/workstations_process
WORKSTATIONS_POLL_INTERVAL=15000

# Document manager API
DOC_MANAGER_URL=http://localhost:5200

# Network share for edited PDFs (leave empty to skip)
EDITED_PDF_PATH=

# ── Label printing ────────────────────────────────────────────────────────────
# Which action triggers printing: STARTED or FINISHED
LABEL_PRINT_TRIGGER=STARTED
# Per-workplace trigger: LABEL_TRIGGER_<WORKPLACE>=STARTED|FINISHED
# e.g. LABEL_TRIGGER_HARDWARE=FINISHED  LABEL_TRIGGER_MOTOR=STARTED
LABEL_TRIGGER_HARDWARE=
LABEL_TRIGGER_MOTOR=

# UNC path to the Stitky folder (where {salesOrder} {position}.csv files live)
LABEL_CSV_BASE_PATH=

# Path to country code mapping JSON file
LABEL_COUNTRY_CODES_PATH=

# Path to label type config JSON file
LABEL_TYPE_CONFIG_PATH=

# ── Finishing-label printer connection (Godex EZ2250i and/or Zebra) ───────────
# METHOD 1 (recommended): UNC print share
LABEL_PRINTER_UNC_PATH=
# Per-workplace printer: LABEL_PRINTER_UNC_<WORKPLACE> / LABEL_PRINTER_HOST_<WORKPLACE>
# Falls back to LABEL_PRINTER_UNC_PATH / LABEL_PRINTER_HOST when not set.
LABEL_PRINTER_UNC_HARDWARE=
LABEL_PRINTER_UNC_MOTOR=

# METHOD 2 (fallback): direct TCP to the printer's IP, port 9100
LABEL_PRINTER_HOST=
LABEL_PRINTER_PORT=9100

# Printer command language: "ezpl" (Godex, default) or "zpl" (Zebra, e.g.
# ZD230 — has no EZPL support). Per-workplace via LABEL_PRINTER_LANG_<WORKPLACE>,
# falling back to the global LABEL_PRINTER_LANG. Mixed fleets are expected —
# e.g. Hardware on a Zebra while Motor stays on a Godex:
LABEL_PRINTER_LANG=
LABEL_PRINTER_LANG_HARDWARE=
LABEL_PRINTER_LANG_MOTOR=
# DPI for the zpl path only (font sizing + ^PW/^LL) — must match the DPI the
# EZPL field coordinates were captured at (203, the Godex EZ2250i's native
# resolution) since those dot positions are reused as-is, not rescaled.
# Per-workplace via LABEL_PRINTER_DPI_<WORKPLACE>, falling back to this.
LABEL_PRINTER_DPI=203

# Optional: override copy count from config for all labels
# LABEL_PRINTER_COPIES=1

# ── QR sticker printing ───────────────────────────────────────────────────────
# Path to TMP*.TXT order files
LABEL_TMP_FILES_PATH=
# Path to the folder containing QR PNG images
LABEL_QR_IMAGES_PATH=

# ── Document printing (PBOM, declarations, confirmations) ─────────────────────
# Printer's IP address (leave empty for dry-run).
DOCUMENTS_PRINTER_HOST=
DOCUMENTS_PRINTER_PORT=9100
# Ghostscript output device: pxlmono (default), pxlcolor, ljet4, ps2write
DOCUMENTS_PRINTER_DEVICE=pxlmono
# Set to "true" to print documents double-sided. Only affects PBOM/
# declaration/confirmation PDFs, not label printing.
DOCUMENTS_PRINTER_DUPLEX=
# LONGEDGE (default, portrait flip on left/long side) or SHORTEDGE
# (landscape flip on top/short side). Only used when DUPLEX=true.
DOCUMENTS_PRINTER_BINDING=LONGEDGE
# Ghostscript render DPI. 300 is ~4x faster than default 600 with good quality for text docs.
DOCUMENTS_PRINTER_DPI=300

# Prep label printer (Godex/Zebra) - separate from the A4 documents printer
# Leave PREP_LABEL_PRINTER_HOST empty to return PDF to mobile instead
PREP_LABEL_PRINTER_HOST=
PREP_LABEL_PRINTER_PORT=9100
# gs output device (pxlmono/pxlcolor/ljet4/ps2write) for a PCL/PS-capable
# printer, OR "zpl" for a ZPL-native printer (e.g. Zebra ZD230) which has no
# PCL/PostScript engine — the PDF is rasterized and sent as a ZPL ^GFA
# graphic field instead. See documentPrinterService.ts.
PREP_LABEL_PRINTER_DEVICE=pxlmono
# Must match the printer's actual configured DPI — in "zpl" mode this
# directly sets the ^PW/^LL dot dimensions.
PREP_LABEL_PRINTER_DPI=203
# Comma-separated list of document type IDs to fetch from doc_manager
DOCUMENTS_TYPES=4,5

# ── Retention archival ────────────────────────────────────────────────────────
# Network share path for archived PDF/A copies (leave empty to disable)
ARCHIVE_SHARE_PATH=
# Days after FINISHED before archival eligibility
ARCHIVE_RETENTION_DAYS=7
# Comma-separated document type IDs to archive
ARCHIVE_DOCUMENT_TYPES=14,4,5,21
# How often the archival sweep runs (ms) - default 6 hours
ARCHIVE_POLL_INTERVAL_MS=21600000
# Max retry attempts per order before giving up
ARCHIVE_MAX_ATTEMPTS=5

# ── Ghostscript (for PDF/A conversion) ────────────────────────────────────────
# Path to Ghostscript binary (must be on PATH if not specified)
GHOSTSCRIPT_PATH=.\gs\bin\gswin64c.exe

# ── Prep-station label (Code 39 barcode font) ───────────────────────────────
# Path to the "BC C39 3 of 9 Light" TrueType font used for the barcode on
# prep-station labels. Checked in this order: this env var, the config/
# folder, C:\Windows\Fonts. When unset/not found, the barcode is drawn as
# vector bars instead (scans the same, slightly different look).
PREP_LABEL_BARCODE_FONT_PATH=

# ── P2L plan loading ──────────────────────────────────────────────────────────
# UNC/local folder the external system drops productionPlanPTL.json into
PTL_PLAN_FOLDER_PATH=
# How often to check the folder for a new drop (ms) - default 30 min
PTL_PLAN_CHECK_INTERVAL_MS=1800000
# How many of the most recent plan drops to keep visible in the prep queue
# at once. Older still-pending rows (superseded, never prepared through the
# app) are pruned on each ingest, since this is the only place that plan is
# shown and stale entries have no reason to linger.
PTL_PLAN_RETAIN_FILES=2

# Motor special orders (non-PTL)
# Base path of the PickByLight folder on this Windows server
PICKBYLIGHT_BASE_PATH=D:\PickByLight
# Path to parts.xlsx (PTL parts database). Defaults to <PICKBYLIGHT_BASE_PATH>\parts.xlsx
PTL_PARTS_XLSX_PATH=

# ── Web frontend (optional) ────────────────────────────────────────────────
# Path to the mobile app's web export. Build it from the mobile project with
# `npx expo export --platform web`, then copy the resulting dist/ folder to
# this path. Served at the same origin/port as the API — no separate web
# server or certificate needed. Leave unset (or point it somewhere that
# doesn't exist) to run API-only.
WEB_BUILD_PATH=
# TOORS ERP integration
# URL of the status_bridge service that closes production orders in TOORS.
# Only status=complete completions are sent. Leave empty to disable.
TOORS_SERVICE_URL=
