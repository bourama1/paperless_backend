{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test all barcodes",
            "type": "shell",
            "command": "scripts\\run-test.bat -KeepFiles",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Test single barcode",
            "type": "shell",
            "command": "scripts\\run-test.bat -KeepFiles",
            "args": ["-Barcode", "${input:barcode}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build backend",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Compile TypeScript to dist/"
        },
        {
            "label": "Build EXE",
            "type": "shell",
            "command": "scripts\\build-exe.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Compile TS + create standalone paperless-backend.exe"
        }
    ],
    "inputs": [
        {
            "id": "barcode",
            "type": "promptString",
            "description": "Enter barcode (e.g. K\"žSV\" 603684 010)",
            "default": "K\"žSV\" 603684 010"
        }
    ]
}
