<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy in front of the paperless backend: IIS terminates HTTPS
  with the server's Sectigo certificate (which stays in the Windows store —
  its private key doesn't need to be exportable) and forwards everything to
  the backend on http://127.0.0.1:5301.

  Needs: IIS with the "WebSocket Protocol" feature, URL Rewrite 2.1 and
  Application Request Routing 3.0 (proxy enabled at server level).
  Backend .env to match: PORT=5301, HOST=127.0.0.1, TRUST_PROXY=true,
  SSL_* empty. See the IIS section in README.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="paperless-backend" stopProcessing="true">
          <match url="(.*)" />
          <!-- query strings are kept (the PDF viewer passes ?apiKey=) -->
          <action type="Rewrite" url="http://127.0.0.1:5301/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- edited PDFs are uploaded as base64 JSON: match the backend's own
             100 MB body limit (IIS defaults to ~30 MB) -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <!-- Socket.IO (live workstation updates, kiosk) -->
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
